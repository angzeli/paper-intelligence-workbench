include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
graft data
graft docs
graft drafts
graft examples
graft notebooks
graft projects
graft reports
graft scripts
graft tests/fixtures
include tests/conftest.py
prune .paperwb
prune .pytest_cache
prune .ruff_cache
prune .idea
prune build
prune dist
prune exports
prune scratch
prune tmp
recursive-exclude projects */.paperwb/*
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude audit_log.jsonl
global-exclude *.pdf
global-exclude *.sqlite
global-exclude *.sqlite3
global-exclude *.db
exclude reports/hostile_review_v0_*.md
